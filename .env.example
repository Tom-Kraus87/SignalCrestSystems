# Signal Crest Systems LLC — environment template (PLACEHOLDERS ONLY)
# Copy to .env.local / Netlify UI. Never commit real secrets.
# Use SEPARATE values for staging vs production resources.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
NODE_ENV=development
# development | staging | production
SCS_ENV=development
# mock | postgres — mock ONLY for local/unit tests; staging/production must use postgres
SCS_DEPENDENCY_MODE=mock
# Explicit local-only escape hatch (ignored when SCS_ENV is staging/production)
SCS_ALLOW_MOCK_LEADS=true
# Allow client isTest flag ONLY in non-prod-like local harnesses (default: ignore)
# SCS_ALLOW_CLIENT_TEST_FLAG=true

# ---------------------------------------------------------------------------
# Lead intake (Netlify Functions — server-only)
# ---------------------------------------------------------------------------
LEADS_INTAKE_ENABLED=true
LEAD_IP_HASH_SALT=REPLACE_WITH_STRONG_RANDOM_SALT_STAGING_OR_PROD
# Current privacy stamp accepted by server allowlist
SCS_PRIVACY_VERSION=privacy-2026-11-23

# ---------------------------------------------------------------------------
# Supabase PostgreSQL — STAGING (separate project from production)
# Required when SCS_DEPENDENCY_MODE=postgres or SCS_ENV=staging|production
#
# IDENTITY MODEL (M7A-R2 A2):
# - Prefer DATABASE_INTAKE_URL with role scs_intake_runtime (minimum privileges).
# - Do NOT use the administrative `postgres` role as the Function identity.
# - node-postgres DB roles are NOT interchangeable with Supabase service_role JWT.
# - SUPABASE_SERVICE_ROLE_KEY is for PostgREST/admin paths only (owner dashboard later).
# - Pooling: DATABASE_POOL_MAX (default 2). Rotate passwords via Supabase dashboard;
#   update Netlify context secrets; recycle Function instances after rotation.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
# Optional PostgREST admin path (NOT used by direct node-postgres intake adapters)
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_STAGING_SERVICE_ROLE_KEY_SERVER_ONLY
# Dedicated intake runtime principal (preferred for Functions)
DATABASE_INTAKE_URL=postgresql://scs_intake_runtime:REPLACE_STAGING_INTAKE_PASSWORD@db.YOUR_STAGING_PROJECT.supabase.co:5432/postgres?sslmode=verify-full
# Migration tooling only (never Function runtime)
# DATABASE_MIGRATION_URL=postgresql://scs_migration:REPLACE_STAGING_MIGRATION_PASSWORD@db.YOUR_STAGING_PROJECT.supabase.co:5432/postgres?sslmode=verify-full
# Notify worker principal
# DATABASE_NOTIFY_URL=postgresql://scs_notify_worker:REPLACE_STAGING_NOTIFY_PASSWORD@db.YOUR_STAGING_PROJECT.supabase.co:5432/postgres?sslmode=verify-full
# Fallback URL (rejected in prod-like if user is postgres unless SCS_ALLOW_ADMIN_DB_USER=true)
DATABASE_URL=postgresql://scs_intake_runtime:REPLACE_STAGING_INTAKE_PASSWORD@db.YOUR_STAGING_PROJECT.supabase.co:5432/postgres?sslmode=verify-full
# TLS: verification REQUIRED in staging/production. Trusted CA optional.
# PGSSLMODE=verify-full
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DATABASE_SSL_CA_PATH=/path/to/supabase-ca.crt
# DATABASE_POOL_MAX=2

# ---------------------------------------------------------------------------
# Supabase PostgreSQL — PRODUCTION (separate project; do not reuse staging keys)
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co
# DATABASE_INTAKE_URL=postgresql://scs_intake_runtime:REPLACE_PRODUCTION_INTAKE_PASSWORD@db.YOUR_PRODUCTION_PROJECT.supabase.co:5432/postgres?sslmode=verify-full
# DATABASE_URL=postgresql://scs_intake_runtime:REPLACE_PRODUCTION_INTAKE_PASSWORD@db.YOUR_PRODUCTION_PROJECT.supabase.co:5432/postgres?sslmode=verify-full

# ---------------------------------------------------------------------------
# Future Supabase Auth (owner dashboard) — not enabled for public intake
# ---------------------------------------------------------------------------
# SUPABASE_ANON_KEY=REPLACE_ANON_KEY_PUBLIC_OK_BUT_RLS_MUST_DENY_LEADS
# OWNER_ALLOWLIST_EMAIL=tom@example.com

# ---------------------------------------------------------------------------
# Netlify Functions (hosting) — configure in Netlify UI per site/context
# ---------------------------------------------------------------------------
# Site-scoped secrets only. Do NOT put production credentials in shared team vars.
# Contexts: branch-deploy / deploy-preview / production must use isolated secrets.
# Trusted client IP: x-nf-client-connection-ip (do not trust visitor X-Forwarded-For).

# ---------------------------------------------------------------------------
# Email notification — Resend contract (OPTIONAL; leave unset = disabled)
# Modes: disabled (default) | simulated | operational
# Do NOT set operational / live delivery without Owner authorization.
# ---------------------------------------------------------------------------
# EMAIL_NOTIFY_MODE=disabled
# EMAIL_NOTIFY_ENABLED=false
# EMAIL_PROVIDER=none
# EMAIL_FROM=noreply@example.com
# EMAIL_TO_OWNER=tom@example.com
# RESEND_API_KEY=REPLACE_ONLY_AFTER_VENDOR_APPROVAL
# POSTMARK_SERVER_TOKEN=REPLACE_ONLY_AFTER_VENDOR_APPROVAL

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (OPTIONAL — honeypot is built-in; leave unset)
# When TURNSTILE_REQUIRED=true, missing/placeholder secret fails closed.
# ---------------------------------------------------------------------------
# TURNSTILE_REQUIRED=false
# TURNSTILE_SECRET_KEY=REPLACE_ONLY_IF_CAPTCHA_AUTHORIZED
# TURNSTILE_SITE_KEY=REPLACE_ONLY_IF_CAPTCHA_AUTHORIZED

# ---------------------------------------------------------------------------
# Optional Sentry monitoring (OPTIONAL — do not enable until staging approved)
# ---------------------------------------------------------------------------
# SENTRY_DSN=REPLACE_ONLY_AFTER_MONITORING_APPROVAL
# SENTRY_ENVIRONMENT=staging

# ---------------------------------------------------------------------------
# Phase B Advisor AI (DISABLED — do not set live vendor keys in M7A)
# ---------------------------------------------------------------------------
ADVISOR_LLM_ENABLED=false
# OPENAI_API_KEY=DO_NOT_SET_UNTIL_PHASE_B_APPROVAL
# ANTHROPIC_API_KEY=DO_NOT_SET_UNTIL_PHASE_B_APPROVAL

# ---------------------------------------------------------------------------
# Explicitly NOT used (cost optimization — Postgres counters instead)
# ---------------------------------------------------------------------------
# REDIS_URL=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Encrypted recovery journal — SEPARATELY GATED (do not implement opportunistically)
# ---------------------------------------------------------------------------
# SCS_RECOVERY_JOURNAL_ENABLED=false
