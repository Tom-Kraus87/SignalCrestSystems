pricing-preview.html
pricing-preview.css

# Local secrets (use .env.example placeholders only — never commit real keys)
.env
.env.local
.env.*.local

# Temp / local artifacts
netlify-init-output.txt
netlify-api-data.json
github-webhook.json
node_modules/
.sharp-tmp/
scripts/__pycache__/
__pycache__/

