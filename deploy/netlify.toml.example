# PROPOSED — do not replace root netlify.toml until deployment changes are approved.
# Dedicated public publish directory. Business folders stay outside site/.

[build]
  command = "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/sync-public.ps1"
  publish = "site"

# Optional: keep form detection explicit after the publish-dir switch
[build.processing]
  skip_processing = false
