# Reference copy of the active root netlify.toml pattern for isolated publishing.
# Live settings live in the repository-root netlify.toml.
#
# For production releases that must fail closed without an origin, set in the
# Netlify UI (or host env) — do not rely on NODE_ENV alone:
#   SCS_PRODUCTION_RELEASE = 1
#   SITE_ORIGIN = https://www.signalcrestsystems.com
# See site-origin.example for validation rules and local invocation examples.
# Alternatively pass: node scripts/build-public.mjs --production-release

[build]
  command = "node scripts/build-public.mjs"
  publish = "dist"
